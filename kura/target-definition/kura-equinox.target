<?pde version="3.8"?>
<target name="Kura Target Definition" sequenceNumber="53">
    <locations>
        <!--
            Single Maven location, no Profile location with absolute paths.
            Monorepo target only pulls third-party bundles via
            target-platform-pde-deps. Intra-monorepo plugins (org.eclipse.kura.*)
            are picked up automatically from the Tycho reactor, so kura-pde-deps
            is NOT listed here — listing it would create a chicken-and-egg
            (api compile -> target -> kura-pde-deps -> api JAR not yet built).
            Sibling repos (outside this reactor) reference kura-pde-deps from
            their own target files; they resolve it from ~/.m2 after monorepo
            install.
            One-time setup:
                mvn -f target-platform/pom.xml install
        -->
        <location includeDependencyDepth="direct" includeDependencyScopes="compile,test"
            missingManifest="ignore" type="Maven">

            <dependencies>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>target-platform-pde-deps</artifactId>
                    <version>6.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-camel-pde-deps</artifactId>
                    <version>1.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-artemis-pde-deps</artifactId>
                    <version>1.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-position-pde-deps</artifactId>
                    <version>2.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-management-ui-pde-deps</artifactId>
                    <version>3.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-opcua-pde-deps</artifactId>
                    <version>2.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-yofc-runtime-pde-deps</artifactId>
                    <version>1.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
            </dependencies>

            <repositories>
                <repository>
                    <id>eclipse-releases</id>
                    <url>https://repo.eclipse.org/content/groups/releases/</url>
                </repository>               
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2/</url>
                </repository>
                <repository>
                    <id>jitpack.io</id>
                    <url>https://jitpack.io</url>
                </repository>
            </repositories>
        </location>
    </locations>
</target>
