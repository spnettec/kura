<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: EPL-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-build-parent</artifactId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>../../../build-support/kura-build-parent/pom.xml</relativePath>
    </parent>
    <artifactId>kura-softhsm2-file</artifactId>
    <packaging>pom</packaging>
    <name>Kura optional SoftHSM file-token module</name>
    <properties>
        <package.revision>1</package.revision>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>package-softhsm2-file</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>${project.basedir}/build.sh</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${package.revision}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
