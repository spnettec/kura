<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>distrib</artifactId>
        <groupId>org.eclipse.kura</groupId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>docker-base</artifactId>
    <name>docker-base</name>

    <packaging>pom</packaging>

    <properties>
        <kura.basedir>../</kura.basedir>
        <dist.assembly.name>kura_${project.version}_docker-nn</dist.assembly.name>
        <dist.assembly.skip>false</dist.assembly.skip>
        <dist.linux.bundles.skip>false</dist.linux.bundles.skip>
        <!-- docker-base supplies its own variant overlay; skip the linux-family overlay. -->
        <dist.linux.family.skip>true</dist.linux.family.skip>
        <dist.network.resources.skip>true</dist.network.resources.skip>
        <dist.build.name>docker-nn</dist.build.name>
        <dist.kura.version.label>YOFC SMART IOT EDGE GATEWAY V${kura.version}</dist.kura.version.label>
        <target.device>docker-nn</target.device>
        <kura.os.version>linux</kura.os.version>
        <!-- docker-base's overlay lives next to its own pom (Dockerfile + docker-only assets). -->
        <variant.resources.dir>${project.basedir}/src/main/resources</variant.resources.dir>
    </properties>

   <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create-timestamp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-yofc-dp-into-context</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <skip>${dist.dp.skip}</skip>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-api-comp</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-apps-comp</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-repack-vertx-db</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-apps-opcuaserver</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-apps-influxdb</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-apps-influxdbv1</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!-- The web2 bundle is split out into the kura-management-ui addon .deb for
                         linux variant. Docker images don't run apt, so we re-bundle
                         the management-ui jar directly into the docker zip's plugins/6s/. -->
                    <execution>
                        <id>copy-management-ui-into-docker-zip</id>
                        <phase>none</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/${dist.assembly.name}/plugins/6s</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.eclipse.kura</groupId>
                                    <artifactId>org.eclipse.kura.web2</artifactId>
                                    <version>3.0.0-SNAPSHOT</version>
                                    <type>jar</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-deb-control</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/filtered-control</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/resources/unfiltered/deb/control</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-dockerfile</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/resources/unfiltered</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>Dockerfile</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Re-bundle the management-ui addon's favicon assets into the docker zip,
                         since docker images don't get them via the apt-installed addon .deb. -->
                    <execution>
                        <id>copy-management-ui-favicons-into-docker-zip</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/${dist.assembly.name}/console/skin</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-management-ui/distrib/extra/console/skin</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb-version}</version>
                <executions>
                    <execution>
                        <id>docker-nn-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <verbose>true</verbose>
                            <deb>${basedir}/target/kura_${package.version}-${package.revision}_docker-nn_installer_${deb.arch}.deb</deb>
                            <snapshotExpand>true</snapshotExpand>
                            <snapshotTemplate>${package.snapshot}</snapshotTemplate>
                            <controlDir>${project.build.directory}/filtered-control</controlDir>
                            <skipPOMs>false</skipPOMs>
                            <dataSet>
                                <data>
                                    <src>${basedir}/target/kura_${project.version}_docker-nn</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/tmp</prefix>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>docker-nn-build-container</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>docker</executable>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>-t</argument>
                                <argument>base-kura-docker:latest</argument>
                                <argument>.</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
