[Unit]
Description=Kura JVM with the Netplan agent adapter
After=network.target

[Service]
Type=simple
User=kura-netplan
Group=kura-netplan
WorkingDirectory=/opt/eclipse/kura
ExecStart=/usr/bin/python3 /opt/eclipse/kura/bin/launch-netplan.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
SuccessExitStatus=143
UMask=0077
RuntimeDirectory=kura-netplan
RuntimeDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/kura-netplan /var/log/kura-netplan

[Install]
WantedBy=multi-user.target
