<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>distrib</artifactId>
        <groupId>org.eclipse.kura</groupId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>gateway</artifactId>
    <name>gateway</name>
    <packaging>pom</packaging>
    <properties>
        <kura.basedir>../</kura.basedir>
        <dist.assembly.name>kura_${project.version}_linux</dist.assembly.name>
        <dist.assembly.skip>false</dist.assembly.skip>
        <dist.linux.bundles.skip>false</dist.linux.bundles.skip>
        <dist.linux.family.skip>false</dist.linux.family.skip>
        <dist.network.resources.skip>false</dist.network.resources.skip>
        <target.device>linux</target.device>
        <dist.build.name>linux</dist.build.name>
        <dist.kura.version.label>YOFC SMART IOT EDGE GATEWAY V${kura.version}</dist.kura.version.label>
    </properties>
    <dependencies>
        <!-- Private worker ordering only; never copied into the OSGi plugin levels. -->
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>kura-key-crypto</artifactId>
            <version>6.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>kura-offline-recovery</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create-timestamp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-deb-control</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/filtered-control</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../src/main/resources/variants/linux/unfiltered/deb/control</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-empty-dpa-properties</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/kura_${project.version}_linux/packages</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/packages-empty</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>embed-preinstall-encryption-key-policy</id>
                        <phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <loadfile property="kura.key.policy.source"
                                          srcFile="${project.basedir}/../src/main/resources/unfiltered/pkg/bin/kura_key_store.py"
                                          encoding="UTF-8"/>
                                <replace file="${project.build.directory}/filtered-control/preinst"
                                         token="raise RuntimeError(&quot;Kura key provisioner was not embedded&quot;)"
                                         value="${kura.key.policy.source}"
                                         failOnNoReplacements="true"/>
                                <loadfile property="kura.key.lifecycle.source"
                                          srcFile="${project.basedir}/../src/main/resources/unfiltered/pkg/bin/kura_key_service_lifecycle.py"
                                          encoding="UTF-8"/>
                                <replace file="${project.build.directory}/filtered-control/preinst"
                                         token="raise RuntimeError(&quot;Kura key-service lifecycle was not embedded&quot;)"
                                         value="${kura.key.lifecycle.source}"
                                         failOnNoReplacements="true"/>
                                <exec executable="python3" failonerror="true">
                                    <arg value="-B"/>
                                    <arg value="${project.basedir}/prepare-key-service.py"/>
                                    <arg value="${project.build.directory}/${dist.assembly.name}"/>
                                    <arg value="${project.basedir}/../kura-key-crypto/target"/>
                                    <arg value="${project.basedir}/../../tools/kura-offline-recovery/target"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb-version}</version>
                <executions>
                    <execution>
                        <id>gateway-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <verbose>true</verbose>
                            <deb>${basedir}/target/kura_${package.version}-${package.revision}_${deb.arch}.deb</deb>
                            <snapshotExpand>true</snapshotExpand>
                            <snapshotTemplate>${package.snapshot}</snapshotTemplate>
                            <controlDir>${project.build.directory}/filtered-control</controlDir>
                            <skipPOMs>false</skipPOMs>
                            <dataSet>
                                <data>
                                    <src>${project.basedir}/src/main/resources/deb-config/preserved-state.conf</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/etc/kura</prefix>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-journal-export.socket</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-journal-export@.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-journal-export.conf</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/sysusers.d</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/libexec/journal-export</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/kura-journal-export</prefix>
                                        <filemode>644</filemode>
                                        <dirmode>755</dirmode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-command-executor.socket</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-command-executor@.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/libexec/command-executor</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/kura-command-executor</prefix>
                                        <filemode>644</filemode>
                                        <dirmode>755</dirmode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-modem-driver.socket</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-modem-driver@.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/libexec/modem-driver</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/kura-modem-driver</prefix>
                                        <filemode>644</filemode>
                                        <dirmode>755</dirmode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-bind-service.socket</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-bind-service@.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/libexec/bind-service</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/kura-bind-service</prefix>
                                        <filemode>644</filemode>
                                        <dirmode>755</dirmode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-dhcp-service.socket</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-modem-reset.socket</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-dhcp-service@.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-modem-reset@.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/install/kura-dhcp.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/systemd/system</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/libexec/dhcp-service</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/kura-dhcp-service</prefix>
                                        <filemode>644</filemode>
                                        <dirmode>755</dirmode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/${dist.assembly.name}/libexec/modem-reset</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/kura-modem-reset</prefix>
                                        <filemode>644</filemode>
                                        <dirmode>755</dirmode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${basedir}/target/kura_${project.version}_linux</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/opt/eclipse/kura_${project.version}_linux</prefix>
                                    </mapper>
                                </data>
                                <!-- 99-kura-nm.conf moved to kura-networking sibling deb. -->
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

