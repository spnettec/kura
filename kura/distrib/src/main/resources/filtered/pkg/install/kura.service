[Unit]
OnFailure=kura-key-recovery.service
Description=Kura
Wants=NetworkManager.service ModemManager.service dbus.service
Requires=kura-key-service.socket
Requires=kura-clock-broker.socket
After=NetworkManager.service ModemManager.service dbus.service kura-key-service.socket
After=kura-clock-broker.socket kura-clock-broker.service

[Service]
User=kurad
Group=kurad
UMask=0077
Type=forking
ExecStartPre=/usr/bin/python3 -I INSTALL_DIR/kura/bin/kura_key_store.py check-loaded-managed
ExecStartPre=/usr/bin/python3 -I INSTALL_DIR/kura/bin/kura_su_pam.py check-installed
ExecStart=/bin/sh INSTALL_DIR/kura/bin/start_kura_background.sh
ExecStop=/usr/bin/python3 -I -B INSTALL_DIR/kura/bin/kura_framework_stop.py ${MAINPID}
ExecStopPost=/usr/bin/python3 -I -B INSTALL_DIR/kura/bin/kura_watchdog_maintenance.py pulse
PIDFile=/var/run/kura.pid
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
# The synchronous ExecStop drains the JVM before the final cgroup cleanup.
KillMode=control-group
TimeoutStopSec=45s
# Realtime and RTC changes belong to the clock actor, not the JVM.
AmbientCapabilities=cap_net_admin cap_net_raw cap_dac_override cap_dac_read_search cap_net_bind_service cap_kill cap_sys_module cap_sys_tty_config cap_syslog
# su needs setuid/setgid in its bounding set, but the JVM receives neither.
CapabilityBoundingSet=cap_net_admin cap_net_raw cap_dac_override cap_dac_read_search cap_net_bind_service cap_kill cap_sys_module cap_sys_tty_config cap_syslog cap_setuid cap_setgid
# DAC capabilities must not make installed code or canonical credentials writable.
# Keep ownership markers readable and let their external writers update them.
ReadOnlyPaths=/opt/eclipse /etc/kura /run/kura-key-service
# Core uses the typed socket, never the independent service's journal or HMAC key.
InaccessiblePaths=/var/lib/kura-key-service /var/lib/kura-key-recovery /etc/kura/recovery-tls /var/lib/kura-clock-broker /usr/libexec/kura-clock-broker -/var/lib/kura-reboot-broker
ReadWritePaths=/opt/eclipse/kura/user /opt/eclipse/kura/data /opt/eclipse/kura/packages /opt/eclipse/kura/log /opt/eclipse/kura/.data
LoadCredential=kura_encryption_key:/etc/kura/credentials/kura_encryption_key

[Install]
WantedBy=multi-user.target
