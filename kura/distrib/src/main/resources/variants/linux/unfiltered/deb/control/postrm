INSTALL_DIR=/opt/eclipse

case "$1" in
    purge|remove)
        # Log uninstallation to /var/log (survives kura removal)
        TIMESTAMP=$(date +%Y%m%d%H%M)
        LOG=/var/log/kura_core_install_${TIMESTAMP}.log

        {
            echo "Uninstalling KURA..."
            echo "  Status: $1"
            echo "  Timestamp: $(date)"
            echo "  Install directory: ${INSTALL_DIR}/kura"
        } 2>&1 | tee -a "$LOG" | systemd-cat -t Kura

        # Remove kura installation tree (plugins/ + siblings/)
        if [ -d "${INSTALL_DIR}/kura" ] ; then
            ${INSTALL_DIR}/kura/.data/manage_kura_users.sh -u 2>/dev/null || true
            TARGET=$(readlink -f "${INSTALL_DIR}/kura" 2>/dev/null || echo "")
            rm -rf "${INSTALL_DIR}/kura"
            case "${TARGET}" in
                "${INSTALL_DIR}"/kura_*)
                    rm -rf "${TARGET}"
                    ;;
            esac
        fi

        {
            echo "KURA uninstallation completed."
        } 2>&1 | tee -a "$LOG" | systemd-cat -t Kura

        # /etc/network/interfaces, /etc/default/dnsmasq, netplan .kurasave
        # restoration is owned by kura-networking's postrm — kura-core no
        # longer touches the host's network configuration.

        rm -rf /tmp/.kura /tmp/kura
        rm -f /var/run/kura.pid
        ;;
    upgrade|failed-upgrade)
        ;;
esac
exit 0
