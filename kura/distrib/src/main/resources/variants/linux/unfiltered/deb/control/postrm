INSTALL_DIR=/opt/eclipse
RETAINED_DIR=/var/lib/kura-retained

case "$1" in
    purge|remove)
        # Log uninstallation to /var/log (survives kura removal)
        TIMESTAMP=$(date +%Y%m%d%H%M)
        LOG=/var/log/kura_core_install_${TIMESTAMP}.log

        {
            echo "Uninstalling KURA..."
            echo "  Status: $1"
            echo "  Timestamp: $(date)"
            echo "  Install directory: ${INSTALL_DIR}/kura"
        } 2>&1 | tee -a "$LOG" | systemd-cat -t Kura

        # A remove preserves user state in prerm before dpkg removes files.
        # If that safeguard was bypassed, retain the tree instead of losing it.
        if [ "$1" = "remove" ] && [ -d "${INSTALL_DIR}/kura" ] && [ ! -d "${RETAINED_DIR}" ]; then
            echo "Refusing to remove Kura's installation tree without a retained user-data copy." >&2
            exit 1
        fi

        # Remove kura installation tree (plugins/ + siblings/)
        if [ -d "${INSTALL_DIR}/kura" ] ; then
            ${INSTALL_DIR}/kura/.data/manage_kura_users.sh -u 2>/dev/null || true
            TARGET=$(readlink -f "${INSTALL_DIR}/kura" 2>/dev/null || echo "")
            rm -rf "${INSTALL_DIR}/kura"
            case "${TARGET}" in
                "${INSTALL_DIR}"/kura_*)
                    rm -rf "${TARGET}"
                    ;;
            esac
        fi

        {
            echo "KURA uninstallation completed."
        } 2>&1 | tee -a "$LOG" | systemd-cat -t Kura

        # /etc/network/interfaces, /etc/default/dnsmasq, netplan .kurasave
        # restoration is owned by kura-networking's postrm — kura-core no
        # longer touches the host's network configuration.

        rm -rf /tmp/.kura /tmp/kura
        rm -f /var/run/kura.pid
        if [ "$1" = "purge" ]; then
            rm -rf "${RETAINED_DIR}" "${INSTALL_DIR}/.kura-preserve" || exit 1
            rm -rf /etc/systemd/system/kura.service.d || exit 1
            rm -f /etc/systemd/system/kura.service || exit 1
            rm -f /var/log/kura*.log* /var/log/kura*.gz /var/log/kura*.hprof || exit 1
            rm -rf /var/log/kura || exit 1
            for retained_tmp in /var/lib/.kura-retained.tmp.*; do
                [ -e "${retained_tmp}" ] || continue
                rm -rf "${retained_tmp}" || exit 1
            done
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
esac
exit 0
