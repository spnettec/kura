INSTALL_DIR=/opt/eclipse
WD_TMP_FILE=/tmp/watchdog
REFRESH_TIME=5
TIMEOUT_TIME=300
TIMESTAMP=$(date +%Y%m%d%H%M)
LOG=/var/log/kura_core_install_${TIMESTAMP}.log
RETAINED_DIR=/var/lib/kura-retained

# Save mutable state before dpkg removes any package-owned files.  Stage into
# a private directory and publish it only after every copy succeeds; never
# replace an earlier recovery copy from an interrupted operation.
function preserveUserData {
    [ -d "${INSTALL_DIR}/kura" ] || return 0
    if [ -e "${RETAINED_DIR}" ]; then
        echo "Cannot remove Kura: ${RETAINED_DIR} already exists; preserve it for recovery." >&2
        return 1
    fi
    local retained_tmp
    retained_tmp=$(mktemp -d "/var/lib/.kura-retained.tmp.XXXXXXXX") || return 1
    for retained_tree in user data packages log; do
        if [ -d "${INSTALL_DIR}/kura/${retained_tree}" ]; then
            if ! cp -a "${INSTALL_DIR}/kura/${retained_tree}" "${retained_tmp}/${retained_tree}"; then
                echo "Cannot remove Kura: failed to preserve ${retained_tree}." >&2
                rm -rf "${retained_tmp}"
                return 1
            fi
        fi
    done
    # The snapshot master key may be configured in the generated service unit.
    # prerm removes that unit, so it must travel with the snapshots and keys.
    if [ -f /lib/systemd/system/kura.service ]; then
        if ! mkdir -p "${retained_tmp}/systemd" || ! cp -a /lib/systemd/system/kura.service "${retained_tmp}/systemd/kura.service"; then
            echo "Cannot remove Kura: failed to preserve the systemd service configuration." >&2
            rm -rf "${retained_tmp}"
            return 1
        fi
    fi
    if ! mv "${retained_tmp}" "${RETAINED_DIR}"; then
        echo "Cannot remove Kura: failed to publish the recovery copy in ${RETAINED_DIR}." >&2
        rm -rf "${retained_tmp}"
        return 1
    fi
}

##############################################
# UTILITY FUNCTIONS
##############################################
# Run preRemove function and start watchdog if needed
function runPreRemove {
    if [ -f "${WD_TMP_FILE}" ]; then
        WATCHDOG_DEVICE=`cat ${WD_TMP_FILE}`
        preRemove &
        PID=$!
        START=$(date +%s)
        
        while [ -d "/proc/$PID" ]; do
            echo w > ${WATCHDOG_DEVICE}
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
        stopWatchdog
    else
        preRemove &
        PID=$!
        START=$(date +%s)
        
        while [ -d "/proc/$PID" ]; do
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
    fi
}

# Deactivate watchdog device if possible
function stopWatchdog {
    if [ -n "${WATCHDOG_DEVICE}" ]; then
        echo V > ${WATCHDOG_DEVICE}
    fi
}

# Pre-remove script
function preRemove {
    #Remove INIT scripts
    if [ -f /etc/init.d/kura ] ; then
        rm /etc/init.d/kura
        update-rc.d kura remove
    fi
    if [ -f /lib/systemd/system/kura.service ] ; then
        systemctl disable kura
        rm /lib/systemd/system/kura.service
    fi
    # Firewall/iptables/netplan teardown is owned by kura-networking's prerm
    # (it installs them in its postinst too). kura-core no longer touches the
    # host's network configuration.

    #Roll-back logrotate setup
    rm -f  /var/log/logrotate-kura.status
    rm -f  /etc/logrotate-kura.conf
    rm -f  /etc/cron.d/logrotate-kura

    # Runtime and audit logs are user data; leave them until purge.
    rm -rf /tmp/.kura
    rm -rf /tmp/kura

    # Directory cleanup moved to postrm (after sibling packages are purged)
}
##############################################
# END UTILITY FUNCTIONS
##############################################

##############################################
# PRE-REMOVE SCRIPT
##############################################

# Stop a running Kura before either an upgrade or a removal.
if [ "$1" = "remove" ] && [ -f /lib/systemd/system/kura.service ]; then
    if ! systemctl stop kura.service; then
        echo "Cannot remove Kura: the service could not be stopped safely." >&2
        exit 1
    fi
fi
PIDS=`pgrep java`

if [ -f "/var/run/kura.pid" ] ; then
  KURA_PID=`cat /var/run/kura.pid`

  for pid in "${PIDS[@]}"
  do
    if [ "$KURA_PID" == "$pid" ] ; then
      `kill $pid` >> "$LOG" 2>&1
    fi
  done
fi

# In-place upgrade: just stop the running instance. The host integration
# (systemd unit, logrotate cron, tmpfiles) is rebuilt by the new package's
# kura_install.sh, and the user's data (snapshots, deployment packages, keys)
# is carried over by the new package's preinst/postinst — so we deliberately
# skip the teardown below, which would otherwise churn those files.
if [ "$1" == "upgrade" ]; then
    echo "Upgrading KURA: stopping the running instance; snapshots, deployment packages and keys are preserved."
    exit 0
fi

# A failed upgrade is recovered by the new package's scripts; nothing to tear down.
if [ "$1" == "failed-upgrade" ]; then
    exit 0
fi

if [ "$1" = "remove" ]; then
    preserveUserData || exit 1
fi

echo ""
echo "Uninstalling KURA..."

runPreRemove >> "$LOG" 2>&1

echo ""
echo "Uninstalling KURA... Done!"
##############################################
# END PRE-REMOVE SCRIPT
##############################################
