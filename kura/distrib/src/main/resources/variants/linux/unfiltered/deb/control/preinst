INSTALL_DIR=/opt/eclipse
TIMESTAMP=`date +%Y%m%d%H%M%S`
LOG=/var/log/kura_core_install_${TIMESTAMP}.log
WD_TMP_FILE=/tmp/watchdog
REFRESH_TIME=5
TIMEOUT_TIME=300

# dpkg passes the maintainer-script action in $1 ("install" / "upgrade").
# Captured here at top level because preInstall() runs as a background job and
# bash functions shadow the positional parameters.
ACTION="$1"
# Staging area for data preserved across an in-place upgrade. NOTE: the name
# must NOT start with "kura" so the "rm -fr /opt/eclipse/kura*" wipe below skips
# it (the glob only matches paths beginning literally with "kura").
PRESERVE_DIR=${INSTALL_DIR}/.kura-preserve

##############################################
# UTILITY FUNCTIONS
##############################################
# Print the space-separated list of currently-installed Kura sibling packages
# (every kura-* package except kura-core itself), according to dpkg. Empty when
# no sibling is installed. Uses dpkg state, so it is accurate even though the
# upgrade wipe is about to remove the sibling files on disk.
function installedSiblings {
    dpkg-query -W -f='${Status} ${Package}\n' 'kura-*' 2>/dev/null \
        | awk '$1 == "install" && $3 == "installed" && $4 != "kura-core" { print $4 }' \
        | tr '\n' ' '
}

# Run preInstall function and start watchdog if needed
function runPreInstall {
    if [ -f "${WD_TMP_FILE}" ]; then
        WATCHDOG_DEVICE=`cat ${WD_TMP_FILE}`
        preInstall &
        PID=$!
        START=$(date +%s)
        
        while [ -d "/proc/$PID" ]; do
            echo w > ${WATCHDOG_DEVICE}
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
        stopWatchdog
    else
        preInstall &
        PID=$!
        START=$(date +%s)
        
        while [ -d "/proc/$PID" ]; do
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
    fi
}

# Deactivate watchdog device if possible
function stopWatchdog {
    if [ -n "${WATCHDOG_DEVICE}" ]; then
        echo V > ${WATCHDOG_DEVICE}
    fi
}

# Pre-install script
function preInstall {
    # On an in-place upgrade (apt install of a newer kura-core over an existing
    # one), preserve the user's runtime state across the wipe. The runtime trees
    # of the current install (reached via the kura symlink) are copied out to
    # PRESERVE_DIR here and restored by postinst after the new tree is laid down:
    #   user/       - snapshots (config history) + security keys + kura_custom
    #   data/       - persisted runtime state (e.g. H2 db)
    #   packages/   - installed deployment packages (.dp) + dpa.properties registry
    #   siblings/   - sibling bundles installed by other kura-*.deb packages
    # The security keys MUST travel with the snapshots, otherwise the (encrypted)
    # snapshots can no longer be decrypted.
    if [ "${ACTION}" = "upgrade" ] && [ -e "${INSTALL_DIR}/kura" ]; then
        echo "Upgrade detected: preserving user/, data/, packages/ and siblings/ (snapshots, keys, deployment packages, sibling bundles)" >> "${LOG}" 2>&1
        rm -rf "${PRESERVE_DIR}" >> "${LOG}" 2>&1
        mkdir -p "${PRESERVE_DIR}" >> "${LOG}" 2>&1
        # cp -a follows into the symlinked kura dir and keeps perms/ownership.
        for d in user data packages siblings; do
            if [ -d "${INSTALL_DIR}/kura/${d}" ]; then
                cp -a "${INSTALL_DIR}/kura/${d}" "${PRESERVE_DIR}/${d}" >> "${LOG}" 2>&1
            fi
        done
        # Preserve the sibling install-order registry so gen_config_ini.sh
        # maintains the correct bundle precedence after the upgrade.
        if [ -f "${INSTALL_DIR}/kura/framework/sibling-install-order" ]; then
            mkdir -p "${PRESERVE_DIR}/framework" >> "${LOG}" 2>&1
            cp -a "${INSTALL_DIR}/kura/framework/sibling-install-order" "${PRESERVE_DIR}/framework/sibling-install-order" >> "${LOG}" 2>&1
        fi
    fi

    #clean up old installation if present
    rm -fr /opt/eclipse/kura* >> "${LOG}" 2>&1
    rm -fr ${INSTALL_DIR}/kura* >> "${LOG}" 2>&1
    rm -fr /tmp/.kura/ >> "${LOG}" 2>&1
    rm -f /etc/init.d/firewall >> "${LOG}" 2>&1
    rm -f /tmp/coninfo-* >> "${LOG}" 2>&1
    rm -f /var/log/kura.log >> "${LOG}" 2>&1
    rm -f kura-*.zip >> "${LOG}" 2>&1
    rm -f kura_*.zip >> "${LOG}" 2>&1
    echo ""
}
##############################################
# END UTILITY FUNCTIONS
##############################################

##############################################
# PRE-INSTALL SCRIPT
##############################################
PIDS=`pgrep java`

echo ""
if [ "${ACTION}" = "upgrade" ]; then
    SIBLINGS=$(installedSiblings)
    echo "Upgrade install of kura-core (in place). Snapshots, deployment packages (.dp) and security keys are preserved."
    echo "UPGRADE INSTALL of kura-core (in place); preserving snapshots/dp/keys" > "${LOG}" 2>&1
    if [ -n "${SIBLINGS}" ]; then
        echo "###################################################################################"
        echo "#  WARNING: only kura-core is being upgraded. These already-installed sibling      #"
        echo "#  packages stay at their current versions and may be INCOMPATIBLE with the new    #"
        echo "#  core (changed API packages, OSGi versions, snapshot format):                    #"
        echo "#      ${SIBLINGS}"
        echo "#  If the gateway misbehaves after the upgrade, reinstall the matching sibling     #"
        echo "#  .deb versions.                                                                  #"
        echo "###################################################################################"
        echo "Installed siblings not upgraded (possible incompatibility): ${SIBLINGS}" >> "${LOG}" 2>&1
    fi
fi
echo "Installing Kura..."
echo "Installing Kura..." >> "${LOG}" 2>&1

# Kill Kura for installation
if [ -f "/var/run/kura.pid" ] ; then
  KURA_PID=`cat /var/run/kura.pid`

  for pid in "${PIDS[@]}"
  do
    if [ "$KURA_PID" == "$pid" ] ; then
      `kill $pid` >> "${LOG}" 2>&1
    fi
  done
fi

runPreInstall
##############################################
# END PRE-INSTALL SCRIPT
##############################################
