INSTALL_DIR=/opt/eclipse
TIMESTAMP=`date +%Y%m%d%H%M%S`
LOG=/var/log/kura_core_install_${TIMESTAMP}.log
WD_TMP_FILE=/tmp/watchdog
REFRESH_TIME=5
TIMEOUT_TIME=300

##############################################
# UTILITY FUNCTIONS
##############################################
# Print the space-separated list of currently-installed Kura sibling packages
# (every kura-* package except kura-core itself), according to dpkg. Empty when
# no sibling is installed.
function installedSiblings {
    dpkg-query -W -f='${Status} ${Package}\n' 'kura-*' 2>/dev/null \
        | awk '$1 == "install" && $3 == "installed" && $4 != "kura-core" { print $4 }' \
        | tr '\n' ' '
}

# Run postInstall function and start watchdog if needed
function runPostInstall {
    if [ -f "${WD_TMP_FILE}" ]; then
        WATCHDOG_DEVICE=`cat ${WD_TMP_FILE}`
        echo "Got watchdog ${WATCHDOG_DEVICE}" >> $LOG 2>&1
        postInstall &
        PID=$!
        START=$(date +%s)

        while [ -d "/proc/$PID" ]; do
            echo w > ${WATCHDOG_DEVICE}
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
        stopWatchdog
    else
        postInstall &
        PID=$!
        START=$(date +%s)

        while [ -d "/proc/$PID" ]; do
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
    fi
}

# Deactivate watchdog device if possible
function stopWatchdog {
    if [ -n "${WATCHDOG_DEVICE}" ]; then
        echo V > ${WATCHDOG_DEVICE}
    fi
}

# Post-install script
function postInstall {

    mkdir -p ${INSTALL_DIR} >> ${LOG} 2>&1

    #install KURA files — deb unpacks directly under ${INSTALL_DIR}/kura (no zip intermediate)
    if [ -d "${INSTALL_DIR}/kura/install" ]; then
        sh ${INSTALL_DIR}/kura/install/kura_install.sh >> ${LOG} 2>&1
    else
        # Fallback for legacy installations that still use zip-based layout
        KURA_VERSION_DIR=$(ls -d ${INSTALL_DIR}/kura_*/ 2>/dev/null | head -1)
        if [ -n "${KURA_VERSION_DIR}" ]; then
            sh ${KURA_VERSION_DIR}install/kura_install.sh >> ${LOG} 2>&1
        else
            echo "ERROR: No KURA installation files found" >> ${LOG} 2>&1
            exit 1
        fi
    fi

    #clean up
    rm -rf ${INSTALL_DIR}/kura/install >> ${LOG} 2>&1

    # Create siblings/ and the install-order registry. Each sibling .deb's
    # postinst appends its own directory name to this file; the postrm deletes
    # its line on remove|purge. gen_config_ini.sh reads this file to iterate
    # siblings in install order (first-installed wins for duplicate JARs).
    mkdir -p ${INSTALL_DIR}/kura/siblings
    mkdir -p ${INSTALL_DIR}/kura/framework
    if [ ! -f "${INSTALL_DIR}/kura/framework/sibling-install-order" ]; then
        : > "${INSTALL_DIR}/kura/framework/sibling-install-order"
    fi
    chown -R kurad:kurad "${INSTALL_DIR}/kura/framework"
    chmod 664 "${INSTALL_DIR}/kura/framework/sibling-install-order"

    # Migration: drop the obsolete precedence config left by older kura-core
    # versions. Policy is now fixed (kura-core inviolable, first-installed wins).
    rm -f "${INSTALL_DIR}/kura/framework/sibling-precedence.conf"

    # Ensure the runtime log directory exists. Install logs are kept in /var/log
    # so they survive package removal.
    mkdir -p ${INSTALL_DIR}/kura/log

    # Restore the runtime trees preserved by preinst across an in-place upgrade
    # (user/ snapshots + keys, data/, packages/ deployment packages + registry).
    # This overwrites the factory defaults just laid down by kura_install.sh with
    # the user's state. Staging is left in place if the copy-back fails, so
    # nothing is lost.
    PRESERVE_DIR=${INSTALL_DIR}/.kura-preserve
    WAS_UPGRADE=0
    if [ -d "${PRESERVE_DIR}" ]; then
        WAS_UPGRADE=1
        echo "Restoring preserved user/, data/ and packages/ from the previous installation" >> ${LOG} 2>&1
        RESTORE_OK=1
        for d in user data packages; do
            if [ -d "${PRESERVE_DIR}/${d}" ]; then
                mkdir -p "${INSTALL_DIR}/kura/${d}" >> ${LOG} 2>&1
                cp -a "${PRESERVE_DIR}/${d}/." "${INSTALL_DIR}/kura/${d}/" >> ${LOG} 2>&1 || RESTORE_OK=0
            fi
        done
        # Refresh the snapshot_0 recovery copy from the restored snapshots.
        if [ -f "${INSTALL_DIR}/kura/user/snapshots/snapshot_0.xml" ]; then
            cp "${INSTALL_DIR}/kura/user/snapshots/snapshot_0.xml" "${INSTALL_DIR}/kura/.data/snapshot_0.xml" >> ${LOG} 2>&1 || true
        fi
        chown -R kurad:kurad "${INSTALL_DIR}/kura/user" "${INSTALL_DIR}/kura/data" "${INSTALL_DIR}/kura/packages" >> ${LOG} 2>&1 || true
        if [ "${RESTORE_OK}" = "1" ]; then
            rm -rf "${PRESERVE_DIR}" >> ${LOG} 2>&1
            echo "Upgrade complete: previous snapshots, deployment packages and keys restored." >> ${LOG} 2>&1
        else
            echo "WARNING: could not fully restore preserved data; kept at ${PRESERVE_DIR} for manual recovery" >> ${LOG} 2>&1
        fi
    fi

    #flush all cached filesystem to disk
    sync

    echo ""
    if [ "${WAS_UPGRADE}" = "1" ]; then
        echo "Finished. KURA has been UPGRADED in place at ${INSTALL_DIR}/kura and will start automatically after a reboot"
        echo "Snapshots, deployment packages and security keys were preserved."
        SIBLINGS=$(installedSiblings)
        if [ -n "${SIBLINGS}" ]; then
            echo ""
            echo "****************************************************************"
            echo "UPGRADE WARNING: only kura-core was upgraded. These installed"
            echo "sibling packages were NOT upgraded and may be incompatible with"
            echo "the new core:"
            echo "    ${SIBLINGS}"
            echo "Reinstall the matching sibling .deb versions if the gateway"
            echo "misbehaves."
            echo "****************************************************************"
        fi
    else
        echo "Finished. KURA has been installed to ${INSTALL_DIR}/kura and will start automatically after a reboot"
    fi
    echo ""
    echo "****************************************************************"
    echo "WARNING: Set the crypto service encryption key as explained in Eclipse Kura"
    echo "documentation before rebooting to have snapshot encryption enabled."
    echo "****************************************************************"
}
##############################################
# END UTILITY FUNCTIONS
##############################################

##############################################
# POST INSTALL SCRIPT
##############################################

# Handle abort-upgrade case
if [ "$1" = "abort-upgrade" ]; then
    echo "postinst called with abort-upgrade: nothing to do."
    exit 0
fi

runPostInstall
exit 0
#############################################
# END POST INSTALL SCRIPT
##############################################
