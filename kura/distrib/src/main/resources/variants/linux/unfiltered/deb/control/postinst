INSTALL_DIR=/opt/eclipse
TIMESTAMP=`date +%Y%m%d%H%M%S`
LOG=/tmp/kura_install_${TIMESTAMP}.log
WD_TMP_FILE=/tmp/watchdog
REFRESH_TIME=5
TIMEOUT_TIME=300

##############################################
# UTILITY FUNCTIONS
##############################################
# Run postInstall function and start watchdog if needed
function runPostInstall {
    if [ -f "${WD_TMP_FILE}" ]; then
        WATCHDOG_DEVICE=`cat ${WD_TMP_FILE}`
        echo "Got watchdog ${WATCHDOG_DEVICE}" >> $LOG 2>&1
        postInstall &
        PID=$!
        START=$(date +%s)

        while [ -d "/proc/$PID" ]; do
            echo w > ${WATCHDOG_DEVICE}
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
        stopWatchdog
    else
        postInstall &
        PID=$!
        START=$(date +%s)

        while [ -d "/proc/$PID" ]; do
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
    fi
}

# Deactivate watchdog device if possible
function stopWatchdog {
    if [ -n "${WATCHDOG_DEVICE}" ]; then
        echo V > ${WATCHDOG_DEVICE}
    fi
}

# Post-install script
function postInstall {

    mkdir -p ${INSTALL_DIR} >> ${LOG} 2>&1

    #install KURA files — deb unpacks directly under ${INSTALL_DIR}/kura (no zip intermediate)
    if [ -d "${INSTALL_DIR}/kura/install" ]; then
        sh ${INSTALL_DIR}/kura/install/kura_install.sh >> ${LOG} 2>&1
    else
        # Fallback for legacy installations that still use zip-based layout
        KURA_VERSION_DIR=$(ls -d ${INSTALL_DIR}/kura_*/ 2>/dev/null | head -1)
        if [ -n "${KURA_VERSION_DIR}" ]; then
            sh ${KURA_VERSION_DIR}install/kura_install.sh >> ${LOG} 2>&1
        else
            echo "ERROR: No KURA installation files found" >> ${LOG} 2>&1
            exit 1
        fi
    fi

    #clean up
    rm -rf ${INSTALL_DIR}/kura/install >> ${LOG} 2>&1

    # Create siblings/ and the install-order registry. Each sibling .deb's
    # postinst appends its own directory name to this file; the postrm deletes
    # its line on remove|purge. gen_config_ini.sh reads this file to iterate
    # siblings in install order (first-installed wins for duplicate JARs).
    mkdir -p ${INSTALL_DIR}/kura/siblings
    mkdir -p ${INSTALL_DIR}/kura/framework
    if [ ! -f "${INSTALL_DIR}/kura/framework/sibling-install-order" ]; then
        : > "${INSTALL_DIR}/kura/framework/sibling-install-order"
    fi
    chown -R kurad:kurad "${INSTALL_DIR}/kura/framework"
    chmod 664 "${INSTALL_DIR}/kura/framework/sibling-install-order"

    # Migration: drop the obsolete precedence config left by older kura-core
    # versions. Policy is now fixed (kura-core inviolable, first-installed wins).
    rm -f "${INSTALL_DIR}/kura/framework/sibling-precedence.conf"

    #move the log file
    mkdir -p ${INSTALL_DIR}/kura/log
    mv ${LOG} ${INSTALL_DIR}/kura/log/

    #flush all cached filesystem to disk
    sync

    echo ""
    echo "Finished. KURA has been installed to ${INSTALL_DIR}/kura and will start automatically after a reboot"
    echo ""
    echo "****************************************************************"
    echo "WARNING: Set the crypto service encryption key as explained in Eclipse Kura"
    echo "documentation before rebooting to have snapshot encryption enabled."
    echo "****************************************************************"
}
##############################################
# END UTILITY FUNCTIONS
##############################################

##############################################
# POST INSTALL SCRIPT
##############################################

# Handle abort-upgrade case
if [ "$1" = "abort-upgrade" ]; then
    echo "postinst called with abort-upgrade: nothing to do."
    exit 0
fi

runPostInstall
exit 0
#############################################
# END POST INSTALL SCRIPT
##############################################
