INSTALL_DIR=/opt/eclipse
TIMESTAMP=`date +%Y%m%d%H%M%S`
LOG=/var/log/kura_core_install_${TIMESTAMP}.log
WD_TMP_FILE=/tmp/watchdog
REFRESH_TIME=5
TIMEOUT_TIME=300

##############################################
# UTILITY FUNCTIONS
##############################################
# Print the space-separated list of currently-installed Kura sibling packages
# (every kura-* package except kura-core itself), according to dpkg. Empty when
# no sibling is installed.
function installedSiblings {
    dpkg-query -W -f='${Status} ${Package}\n' 'kura-*' 2>/dev/null \
        | awk '$1 == "install" && $3 == "installed" && $4 != "kura-core" { print $4 }' \
        | tr '\n' ' '
}

# Keep the snapshot master-key setting across upgrades while still installing
# the new service template. Never log the key or write it to a public temp file.
function restoreUpgradeSecret {
    python3 - "$1" "$2" <<'PY'
import os
import re
import stat
import sys
import tempfile

saved, target = sys.argv[1:]
pattern = re.compile(rb'^\s*Environment\s*=.*\bKURA_CRYPTO_SECRET_KEY=')
environment_file = re.compile(rb'^\s*EnvironmentFile\s*=')
with open(saved, 'rb') as f:
    original = f.read().splitlines(keepends=True)
with open(target, 'rb') as f:
    current = f.read().splitlines(keepends=True)
secret_lines = [line for line in original if pattern.match(line)]
file_lines = [line for line in original if environment_file.match(line) and line not in current]
positions = [i for i, line in enumerate(current) if pattern.match(line)]
if not positions and (secret_lines or file_lines):
    raise RuntimeError('The new Kura service unit has no place for the preserved key setting')
if positions:
    first = positions[0]
    current = [line for i, line in enumerate(current) if i not in positions]
    current[first:first] = secret_lines + file_lines
    st = os.stat(target)
    fd, path = tempfile.mkstemp(prefix='.kura-service-', dir=os.path.dirname(target))
    try:
        os.fchmod(fd, stat.S_IMODE(st.st_mode))
        os.fchown(fd, st.st_uid, st.st_gid)
        with os.fdopen(fd, 'wb') as f:
            f.writelines(current)
        os.replace(path, target)
    finally:
        if os.path.exists(path):
            os.unlink(path)
PY
}

# Run postInstall function and start watchdog if needed
function runPostInstall {
    if [ -f "${WD_TMP_FILE}" ]; then
        WATCHDOG_DEVICE=`cat ${WD_TMP_FILE}`
        echo "Got watchdog ${WATCHDOG_DEVICE}" >> $LOG 2>&1
        postInstall &
        PID=$!
        START=$(date +%s)

        while [ -d "/proc/$PID" ]; do
            echo w > ${WATCHDOG_DEVICE}
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
        stopWatchdog
    else
        postInstall &
        PID=$!
        START=$(date +%s)

        while [ -d "/proc/$PID" ]; do
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
    fi
    wait "$PID" || return 1
}

# Deactivate watchdog device if possible
function stopWatchdog {
    if [ -n "${WATCHDOG_DEVICE}" ]; then
        echo V > ${WATCHDOG_DEVICE}
    fi
}

# Post-install script
function postInstall {

    mkdir -p ${INSTALL_DIR} >> ${LOG} 2>&1

    #install KURA files — deb unpacks directly under ${INSTALL_DIR}/kura (no zip intermediate)
    if [ -d "${INSTALL_DIR}/kura/install" ]; then
        sh ${INSTALL_DIR}/kura/install/kura_install.sh >> ${LOG} 2>&1
    else
        # Fallback for legacy installations that still use zip-based layout
        KURA_VERSION_DIR=$(ls -d ${INSTALL_DIR}/kura_*/ 2>/dev/null | head -1)
        if [ -n "${KURA_VERSION_DIR}" ]; then
            sh ${KURA_VERSION_DIR}install/kura_install.sh >> ${LOG} 2>&1
        else
            echo "ERROR: No KURA installation files found" >> ${LOG} 2>&1
            exit 1
        fi
    fi

    #clean up
    rm -rf ${INSTALL_DIR}/kura/install >> ${LOG} 2>&1

    # Create siblings/ and the install-order registry. Each sibling .deb's
    # postinst appends its own directory name to this file; the postrm deletes
    # its line on remove|purge. gen_config_ini.sh reads this file to iterate
    # siblings in install order (first-installed wins for duplicate JARs).
    mkdir -p ${INSTALL_DIR}/kura/siblings
    mkdir -p ${INSTALL_DIR}/kura/framework
    if [ ! -f "${INSTALL_DIR}/kura/framework/sibling-install-order" ]; then
        : > "${INSTALL_DIR}/kura/framework/sibling-install-order"
    fi
    chown -R kurad:kurad "${INSTALL_DIR}/kura/framework"
    chmod 664 "${INSTALL_DIR}/kura/framework/sibling-install-order"

    # Migration: drop the obsolete precedence config left by older kura-core
    # versions. Policy is now fixed (kura-core inviolable, first-installed wins).
    rm -f "${INSTALL_DIR}/kura/framework/sibling-precedence.conf"

    # Ensure the runtime log directory exists. Install logs are kept in /var/log
    # so they survive package removal.
    mkdir -p ${INSTALL_DIR}/kura/log

    # Restore the runtime trees preserved by preinst across an in-place upgrade
    # (user/ snapshots + keys, data/, packages/ deployment packages + registry,
    # siblings/ sibling bundles, framework/sibling-install-order precedence).
    # This overwrites the factory defaults just laid down by kura_install.sh with
    # the user's state. Staging is left in place if the copy-back fails, so
    # nothing is lost.
    PRESERVE_DIR=${INSTALL_DIR}/.kura-preserve
    RETAINED_DIR=/var/lib/kura-retained
    WAS_UPGRADE=0
    WAS_REINSTALL=0
    if [ -e "${PRESERVE_DIR}" ] && [ -e "${RETAINED_DIR}" ]; then
        echo "ERROR: both upgrade and removal recovery copies exist; neither will be overwritten." >> ${LOG} 2>&1
        return 1
    fi
    if [ -d "${RETAINED_DIR}" ]; then
        PRESERVE_DIR=${RETAINED_DIR}
        WAS_REINSTALL=1
    fi
    if [ -d "${PRESERVE_DIR}" ]; then
        if [ "${WAS_REINSTALL}" = "0" ]; then
            WAS_UPGRADE=1
        fi
        echo "Restoring preserved user/, data/, packages/ and siblings/ from the previous installation" >> ${LOG} 2>&1
        RESTORE_OK=1
        for d in user data packages log; do
            if [ -d "${PRESERVE_DIR}/${d}" ]; then
                mkdir -p "${INSTALL_DIR}/kura/${d}" >> ${LOG} 2>&1
                cp -a "${PRESERVE_DIR}/${d}/." "${INSTALL_DIR}/kura/${d}/" >> ${LOG} 2>&1 || RESTORE_OK=0
            fi
        done
        # Keep newly unpacked helpers when siblings are upgraded in the same
        # transaction; restore missing hooks after a core-only upgrade.
        if [ -d "${PRESERVE_DIR}/addon-data" ]; then
            mkdir -p "${INSTALL_DIR}/kura/.data" >> ${LOG} 2>&1
            cp -a -n "${PRESERVE_DIR}/addon-data/." "${INSTALL_DIR}/kura/.data/" >> ${LOG} 2>&1 || RESTORE_OK=0
        fi
        if [ -f "${PRESERVE_DIR}/systemd/kura.service" ]; then
            if [ "${WAS_REINSTALL}" = "1" ]; then
                cp -a "${PRESERVE_DIR}/systemd/kura.service" /lib/systemd/system/kura.service >> ${LOG} 2>&1 || RESTORE_OK=0
            else
                restoreUpgradeSecret "${PRESERVE_DIR}/systemd/kura.service" /lib/systemd/system/kura.service >> ${LOG} 2>&1 || RESTORE_OK=0
            fi
            systemctl daemon-reload >> ${LOG} 2>&1 || RESTORE_OK=0
        fi
        # dpkg unpacks every package in a transaction before configuring the
        # core. A sibling directory already present here therefore contains
        # the newly unpacked package; copying the backup over it would silently
        # revert its bundles while dpkg records the new version as installed.
        # Restore only whole sibling directories that were not unpacked again.
        for sibling in "${PRESERVE_DIR}"/siblings/*; do
            [ -d "${sibling}" ] || continue
            sibling_name=${sibling##*/}
            if [ ! -e "${INSTALL_DIR}/kura/siblings/${sibling_name}" ]; then
                cp -a "${sibling}" "${INSTALL_DIR}/kura/siblings/${sibling_name}" >> ${LOG} 2>&1 || RESTORE_OK=0
            fi
        done
        # Restore the sibling install-order registry so gen_config_ini.sh
        # keeps the correct bundle precedence after the upgrade.
        if [ -f "${PRESERVE_DIR}/framework/sibling-install-order" ]; then
            cp -a "${PRESERVE_DIR}/framework/sibling-install-order" "${INSTALL_DIR}/kura/framework/sibling-install-order" >> ${LOG} 2>&1 || true
        fi
        # Refresh the snapshot_0 recovery copy from the restored snapshots.
        if [ -f "${INSTALL_DIR}/kura/user/snapshots/snapshot_0.xml" ]; then
            cp "${INSTALL_DIR}/kura/user/snapshots/snapshot_0.xml" "${INSTALL_DIR}/kura/.data/snapshot_0.xml" >> ${LOG} 2>&1 || true
        fi
        # The retained copy is outside /opt, so its original ownership has not
        # been changed by the installer. Keep it on reinstall, including
        # intentionally root-owned keys. Preserve the existing upgrade policy.
        if [ "${WAS_REINSTALL}" = "0" ]; then
            chown -R kurad:kurad "${INSTALL_DIR}/kura/user" "${INSTALL_DIR}/kura/data" "${INSTALL_DIR}/kura/packages" "${INSTALL_DIR}/kura/log" >> ${LOG} 2>&1 || true
        fi
        if [ "${RESTORE_OK}" = "1" ]; then
            if ! rm -rf "${PRESERVE_DIR}" >> ${LOG} 2>&1; then
                echo "ERROR: restored data but could not remove its recovery copy at ${PRESERVE_DIR}." >> ${LOG} 2>&1
                return 1
            fi
            echo "Upgrade complete: previous snapshots, deployment packages and keys restored." >> ${LOG} 2>&1
        else
            echo "ERROR: could not fully restore preserved data; kept at ${PRESERVE_DIR} for recovery" >> ${LOG} 2>&1
            return 1
        fi
    fi

    #flush all cached filesystem to disk
    sync

    echo ""
    if [ "${WAS_UPGRADE}" = "1" ]; then
        echo "Finished. KURA has been UPGRADED in place at ${INSTALL_DIR}/kura and will start automatically after a reboot"
        echo "Snapshots, deployment packages and security keys were preserved."
        SIBLINGS=$(installedSiblings)
        if [ -n "${SIBLINGS}" ]; then
            echo ""
            echo "****************************************************************"
            echo "UPGRADE WARNING: only kura-core was upgraded. These installed"
            echo "sibling packages were NOT upgraded and may be incompatible with"
            echo "the new core:"
            echo "    ${SIBLINGS}"
            echo "Reinstall the matching sibling .deb versions if the gateway"
            echo "misbehaves."
            echo "****************************************************************"
        fi
    elif [ "${WAS_REINSTALL}" = "1" ]; then
        echo "Finished. KURA has been reinstalled at ${INSTALL_DIR}/kura; previous user data was restored."
    else
        echo "Finished. KURA has been installed to ${INSTALL_DIR}/kura and will start automatically after a reboot"
    fi
    echo ""
    echo "****************************************************************"
    echo "WARNING: Set the crypto service encryption key as explained in Eclipse Kura"
    echo "documentation before rebooting to have snapshot encryption enabled."
    echo "****************************************************************"
}
##############################################
# END UTILITY FUNCTIONS
##############################################

##############################################
# POST INSTALL SCRIPT
##############################################

# A failed remove or upgrade has not completed the installation workflow.
# In particular, do not overwrite a recovery copy after prerm aborts.
if [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-remove" ]; then
    echo "postinst called with $1: preserving the existing installation."
    exit 0
fi

runPostInstall || exit 1
exit 0
#############################################
# END POST INSTALL SCRIPT
##############################################
