[Unit]
# Each device lookup starts a fresh device-policy context, including after hotplug.
StartLimitIntervalSec=0
Description=YOFC Kura read-only RTC device admission
Requires=kura-clock-rtc-devices.socket
After=kura-clock-rtc-devices.socket

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/setpriv --no-new-privs /usr/bin/python3 -I -B /usr/libexec/kura-clock-broker/bin/kura_clock_broker.py serve-rtc
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=char-rtc r
ReadOnlyPaths=/dev
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=-/etc/kura -/var/lib/kura-clock-broker -/var/lib/kura-key-service -/var/lib/kura-key-recovery -/var/lib/kura-management-agent -/var/lib/kura-management-agent-native -/run/kura-key-service -/opt/eclipse/kura
MemoryMax=64M
TasksMax=8
TimeoutStartSec=15
