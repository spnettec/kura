[Unit]
Description=Kura IPv4 DHCP server
After=network.target

[Service]
Type=forking
PIDFile=/run/kura-dhcp/dnsmasq.pid
User=dnsmasq
LoadCredential=dnsmasq.conf:/etc/kura/dhcp-service/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --conf-file=%d/dnsmasq.conf --dhcp-leasefile=/var/lib/kura-dhcp-leases/dnsmasq.leases --pid-file=/run/kura-dhcp/dnsmasq.pid
StateDirectory=kura-dhcp-leases
StateDirectoryMode=0755
RuntimeDirectory=kura-dhcp
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/opt/eclipse -/etc/kura/credentials -/etc/kura/recovery-tls -/var/lib/kura-key-service -/var/lib/kura-key-recovery -/var/lib/kura-dhcp-service
MemoryMax=64M
TasksMax=8
TimeoutStopSec=10s
