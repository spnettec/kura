[Unit]
Description=Kura typed modem reset and GPS policy actor
PartOf=kura.service
Requisite=kura.service
CollectMode=inactive-or-failed

[Service]
Type=exec
User=root
Group=root
StateDirectory=kura-modem-reset
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/libexec/kura-modem-reset/kura_modem_reset.py serve %n
StandardInput=socket
StandardOutput=null
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/etc/kura/credentials -/etc/kura/recovery-tls -/var/lib/kura-key-service -/var/lib/kura-key-recovery -/run/kura-key-service -/opt/eclipse/kura/user -/opt/eclipse/kura/data -/opt/eclipse/kura/packages -/opt/eclipse/kura/.data
MemoryMax=64M
TasksMax=8
RuntimeMaxSec=115s
TimeoutStopSec=5s
