[Unit]
Description=Kura typed BIND service actor
PartOf=kura.service
Requisite=kura.service
CollectMode=inactive-or-failed

[Service]
Type=exec
User=root
Group=root
StateDirectory=kura-bind-service
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/setpriv --no-new-privs /usr/bin/python3 -I -B /usr/libexec/kura-bind-service/kura_bind_service.py serve %n
StandardInput=socket
StandardOutput=null
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=-/etc/bind
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/opt/eclipse -/etc/kura -/var/lib/kura-key-service -/var/lib/kura-key-recovery -/run/kura-key-service
MemoryMax=64M
TasksMax=8
RuntimeMaxSec=70s
TimeoutStopSec=5s
