[Unit]
Description=Kura read-only journal export
PartOf=kura.service
Requisite=kura.service

[Service]
Type=exec
DynamicUser=yes
User=kura-journal-export
SupplementaryGroups=systemd-journal
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/eclipse/kura/bin/kura_journal_export.py serve %n
StandardInput=socket
StandardOutput=null
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/etc/kura -/var/lib/kura-key-service -/var/lib/kura-key-recovery -/run/kura-key-service
MemoryMax=64M
TasksMax=8
LimitFSIZE=33554432
RuntimeMaxSec=45s
TimeoutStopSec=5s
