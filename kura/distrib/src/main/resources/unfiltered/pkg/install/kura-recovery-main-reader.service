# SPDX-License-Identifier: EPL-2.0
[Unit]
Description=Read-only Kura recovery result verification
Requires=kura-recovery-main-reader.socket
After=kura-recovery-main-reader.socket
PartOf=kura-recovery-main-reader.socket
ConditionPathExists=!/var/lib/kura-key-service/maintenance.json
ConditionPathIsDirectory=/var/lib/kura-recovery-launch
# Each bounded Root query activates a fresh reader.
StartLimitIntervalSec=0

[Service]
Type=exec
User=kurad
Group=kurad
ExecStart=/usr/bin/python3 -I -B /run/kura-recovery-main-reader.py read-once
Sockets=kura-recovery-main-reader.socket
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
TemporaryFileSystem=/etc:ro /var/lib:ro /opt/eclipse:ro /run:ro
BindReadOnlyPaths=/opt/eclipse/kura/bin/kura_recovery_launch.py:/run/kura-recovery-main-reader.py
BindReadOnlyPaths=/var/lib/kura-recovery-launch
BindReadOnlyPaths=-/opt/eclipse/kura/user/snapshots
InaccessiblePaths=/proc
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=4
MemoryMax=160M
LimitNOFILE=32
LimitCORE=0
RuntimeMaxSec=15
