<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>distrib</artifactId>
        <groupId>org.eclipse.kura</groupId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>gateway</artifactId>
    <name>gateway</name>

    <packaging>pom</packaging>

    <properties>
        <kura.basedir>../</kura.basedir>
        <dist.assembly.name>kura_${project.version}_linux</dist.assembly.name>
        <dist.assembly.skip>false</dist.assembly.skip>
        <dist.linux.bundles.skip>false</dist.linux.bundles.skip>
        <dist.network.resources.skip>false</dist.network.resources.skip>
        <dist.jdk.dio.resources.skip>false</dist.jdk.dio.resources.skip>
        <dist.profile.resources>linux</dist.profile.resources>
        <dist.build.name>linux</dist.build.name>
        <dist.kura.version.label>YOFC SMART IOT EDGE GATEWAY V${kura.version}</dist.kura.version.label>
        <dist.empty.dpa.skip>false</dist.empty.dpa.skip>
    </properties>

    <profiles>
        <profile>
            <id>include-dp-install-list</id>
            <activation>
                <property>
                    <name>dist.dp.skip</name>
                    <value>false</value>
                </property>
            </activation>
            <properties>
                <dist.empty.dpa.skip>true</dist.empty.dpa.skip>
            </properties>
        </profile>
    </profiles>

   <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create-timestamp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-yofc-dp-into-tree</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <skip>${dist.dp.skip}</skip>
                            <outputDirectory>${project.build.directory}/kura_${project.version}_linux/packages</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-api-comp</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-apps-comp</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-repack-vertx-db</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.yofc.iot</groupId>
                                    <artifactId>yofc-iot-apps-opcuaserver</artifactId>
                                    <version>${yofc.dp.version}</version>
                                    <type>dp</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-deb-control</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/filtered-control</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../src/main/resources/linux/deb/control</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>filter-dpa-properties</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${dist.dp.skip}</skip>
                            <outputDirectory>${project.build.directory}/kura_${project.version}_linux/packages</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/packages</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-empty-dpa-properties</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${dist.empty.dpa.skip}</skip>
                            <outputDirectory>${project.build.directory}/kura_${project.version}_linux/packages</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/packages-empty</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb-version}</version>
                <executions>
                    <execution>
                        <id>gateway-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <verbose>true</verbose>
                            <deb>${basedir}/target/kura_${package.version}-${package.revision}_${deb.arch}.deb</deb>
                            <snapshotExpand>true</snapshotExpand>
                            <snapshotTemplate>${package.snapshot}</snapshotTemplate>
                            <controlDir>${project.build.directory}/filtered-control</controlDir>
                            <skipPOMs>false</skipPOMs>
                            <dataSet>
                                <data>
                                    <src>${basedir}/target/kura_${project.version}_linux.zip</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/tmp</prefix>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/../src/main/resources/common/99-kura-nm.conf</src>
                                    <dst>/etc/NetworkManager/conf.d/99-kura-nm.conf</dst>
                                    <type>file</type>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
