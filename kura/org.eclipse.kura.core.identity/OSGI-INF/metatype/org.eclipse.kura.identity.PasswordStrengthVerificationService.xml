<?xml version="1.0" encoding="UTF-8"?>
<metatype:MetaData xmlns:metatype="http://www.osgi.org/xmlns/metatype/v1.2.0" 
			localization="OSGI-INF/l10n/PasswordStrengthVerificationService">
  <OCD id="org.eclipse.kura.identity.PasswordStrengthVerificationService" 
        name="%name" 
        description="%description">
    <AD id="new.password.min.length" 
        type="Integer" 
        name="%newPasswordMinLength" 
        description="%newPasswordMinLengthDesc" 
        min="0" 
        default="12"/>
    <AD id="new.password.require.digits" 
        type="Boolean" 
        name="%newPasswordRequireDigits" 
        description="%newPasswordRequireDigitsDesc" 
        default="true"/>
    <AD id="new.password.require.special.characters" 
        type="Boolean" 
        name="%newPasswordRequireSpecialCharacters" 
        description="%newPasswordRequireSpecialCharactersDesc" 
        default="true"/>
    <AD id="new.password.require.both.cases" 
        type="Boolean" 
        name="%newPasswordRequireBothCases" 
        description="%newPasswordRequireBothCasesDesc" 
        default="true"/>
  </OCD>
  <Designate pid="org.eclipse.kura.identity.PasswordStrengthVerificationService">
    <Object ocdref="org.eclipse.kura.identity.PasswordStrengthVerificationService"/>
  </Designate>
</metatype:MetaData>
