Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Kura Localization
Bundle-SymbolicName: org.eclipse.kura.localization;singleton:=true
Bundle-Version: 2.0.0.qualifier
Bundle-Vendor: Eclipse Kura
Bundle-License: Eclipse Public License v2.0
Bundle-Category: Localization
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=21))"
Export-Package: org.eclipse.kura.localization;version="1.0.0"
Import-Package: com.github.rodionmoiseev.c10n,
 com.github.rodionmoiseev.c10n.annotations,
 org.eclipse.kura;version="[1.2,2.0)"
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Eclipse-ExtensibleAPI: true

