Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Kura Script Engine Provider
Bundle-SymbolicName: org.eclipse.kura.script.provider
Bundle-Version: 1.0.0.qualifier
Require-Capability: osgi.extender;filter:="(osgi.extender=osgi.serviceloader.registrar)",
 osgi.extender;filter:="(osgi.extender=osgi.serviceloader.processor)",
 osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=21))"
Require-Bundle: groovy
Bundle-ActivationPolicy: lazy
Eclipse-BuddyPolicy: ext
Bundle-Vendor: Eclipse Kura
Bundle-License: Eclipse Public License v2.0
Bundle-ClassPath: .,
 js-language.jar,
 js-scriptengine.jar,
 truffle-runtime.jar,
 truffle-compiler.jar,
 truffle-enterprise.jar,
 polyglot.jar,
 launcher-common.jar,
 jline.jar,
 collections.jar,
 nativeimage.jar,
 word.jar,
 truffle-api.jar,
 icu4j.jar,
 groovy-jsr223.jar,
 regex.jar,
 python-language.jar,
 profiler-tool.jar,
 json.jar,
 truffle-nfi.jar,
 truffle-nfi-libffi.jar,
 llvm-api.jar,
 xz.jar,
 bcprov-jdk18on.jar,
 bcpkix-jdk18on.jar,
 bcutil-jdk18on.jar,
 python-resources.jar,
 wasm-language.jar
Export-Package: org.graalvm.polyglot
Import-Package: org.eclipse.kura.script.validation;version="[1.0,2.0)",
 org.slf4j;version="[1.7,3)"
Service-Component: OSGI-INF/scriptValidationService.xml
Provide-Capability: osgi.serviceloader;osgi.serviceloader=javax.script.ScriptEngineFactory
