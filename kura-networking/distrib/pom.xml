<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        YOFC-branded addon .deb builder for the 9 networking bundles. Source bundles live in
        the spnettec/kura-networking sibling repo at ../../../kura-networking/bundles/...
        Mirrors upstream eclipse-kura/kura-networking's distrib jar→plugins/{4,4s,5s} layout.
    -->
    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>distrib</artifactId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>../../kura/distrib/pom.xml</relativePath>
    </parent>

    <artifactId>kura-networking-distrib</artifactId>
    <name>kura-networking-distrib</name>
    <packaging>pom</packaging>

    <properties>
        <addon.installation.dir>/opt/eclipse/kura/plugins</addon.installation.dir>
        <package.name>kura-networking</package.name>

        <!-- Bundle versions (independent of kura framework version). -->
        <core.net.version>2.0.0-SNAPSHOT</core.net.version>
        <linux.net.version>3.0.0-SNAPSHOT</linux.net.version>
        <linux.systemd.provider.version>2.0.0-SNAPSHOT</linux.systemd.provider.version>
        <net.admin.firewall.version>2.0.0-SNAPSHOT</net.admin.firewall.version>
        <net.configuration.version>2.0.0-SNAPSHOT</net.configuration.version>
        <network.threat.manager.version>2.0.0-SNAPSHOT</network.threat.manager.version>
        <nm.version>2.0.0-SNAPSHOT</nm.version>
        <rest.network.configuration.provider.version>2.0.0-SNAPSHOT</rest.network.configuration.provider.version>
        <rest.network.status.provider.version>2.0.0-SNAPSHOT</rest.network.status.provider.version>

        <!-- Linux-only addon (NM / iptables / dbus deps); arch-neutral java jars. -->
        <deb.architecture>all</deb.architecture>

        <!-- Bypass parent's dist lifecycle (assembly / dep-bundle layers / network skip) — we
             provide our own jdeb step below. -->
        <dist.assembly.skip>true</dist.assembly.skip>
        <dist.linux.bundles.skip>true</dist.linux.bundles.skip>
        <dist.linux.family.skip>true</dist.linux.family.skip>
        <dist.network.resources.skip>true</dist.network.resources.skip>
        <dist.dp.skip>true</dist.dp.skip>
    </properties>

    <build>
        <plugins>
            <!-- Stage the 9 bundle jars (built by the kura/ reactor via Tycho) into a known
                 location so jdeb can pick them up. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-networking-jars</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/input_files</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.core.net/target</directory>
                                    <includes><include>org.eclipse.kura.core.net-${core.net.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.linux.net/target</directory>
                                    <includes><include>org.eclipse.kura.linux.net-${linux.net.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.linux.systemd.provider/target</directory>
                                    <includes><include>org.eclipse.kura.linux.systemd.provider-${linux.systemd.provider.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.net.admin.firewall/target</directory>
                                    <includes><include>org.eclipse.kura.net.admin.firewall-${net.admin.firewall.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.net.configuration/target</directory>
                                    <includes><include>org.eclipse.kura.net.configuration-${net.configuration.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.network.threat.manager/target</directory>
                                    <includes><include>org.eclipse.kura.network.threat.manager-${network.threat.manager.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.nm/target</directory>
                                    <includes><include>org.eclipse.kura.nm-${nm.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.rest.network.configuration.provider/target</directory>
                                    <includes><include>org.eclipse.kura.rest.network.configuration.provider-${rest.network.configuration.provider.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-networking/bundles/org.eclipse.kura.rest.network.status.provider/target</directory>
                                    <includes><include>org.eclipse.kura.rest.network.status.provider-${rest.network.status.provider.version}.jar</include></includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Assemble the addon .deb. Output: kura-networking_VER-REV_all.deb -->
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb-version}</version>
                <executions>
                    <execution>
                        <id>generate-networking-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <verbose>true</verbose>
                            <deb>${basedir}/target/${package.name}_${package.version}-${package.revision}_${deb.architecture}.deb</deb>
                            <snapshotExpand>true</snapshotExpand>
                            <snapshotTemplate>${package.snapshot}</snapshotTemplate>
                            <controlDir>${project.basedir}/deb/control</controlDir>
                            <skipPOMs>false</skipPOMs>
                            <dataSet>
                                <!-- /plugins/4: linux.net, linux.systemd.provider -->
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.linux.net-${linux.net.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.linux.systemd.provider-${linux.systemd.provider.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>

                                <!-- /plugins/4s: core.net, net.configuration, network.threat.manager, rest.network.configuration.provider -->
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.core.net-${core.net.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.net.configuration-${net.configuration.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.network.threat.manager-${network.threat.manager.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.rest.network.configuration.provider-${rest.network.configuration.provider.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>

                                <!-- /plugins/5s: net.admin.firewall, nm, rest.network.status.provider -->
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.net.admin.firewall-${net.admin.firewall.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/5s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.nm-${nm.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/5s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/input_files/org.eclipse.kura.rest.network.status.provider-${rest.network.status.provider.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/5s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
