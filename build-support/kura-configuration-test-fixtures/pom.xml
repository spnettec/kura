<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.eclipse.kura</groupId><artifactId>kura-build-parent</artifactId><version>6.0.0-SNAPSHOT</version><relativePath>../kura-build-parent/pom.xml</relativePath></parent>
  <artifactId>kura-configuration-test-fixtures</artifactId>
  <packaging>bundle</packaging>
  <name>Kura configuration test-only bundle</name>
  <dependencies>
    <dependency><groupId>org.eclipse.kura</groupId><artifactId>org.eclipse.kura.api</artifactId><version>3.0.0-SNAPSHOT</version><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.eclipse.kura</groupId><artifactId>org.eclipse.kura.core.configuration</artifactId><version>3.0.0-SNAPSHOT</version><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.osgi</artifactId><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.opentest4j</groupId><artifactId>opentest4j</artifactId><version>1.3.0</version><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.apiguardian</groupId><artifactId>apiguardian-api</artifactId><version>1.1.2</version><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
  </dependencies>
  <build>
    <resources><resource><directory>${project.basedir}</directory><includes><include>OSGI-INF/**</include></includes></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId>
        <executions><execution><id>prepare-handwritten-manifest</id><phase>generate-resources</phase></execution></executions>
      </plugin>
      <plugin><groupId>org.apache.felix</groupId><artifactId>maven-bundle-plugin</artifactId><extensions>true</extensions>
        <configuration><instructions>
          <_include>${project.build.directory}/osgi/MANIFEST.MF</_include>
          <_nodefaultversion>true</_nodefaultversion><_removeheaders>Include-Resource,Private-Package</_removeheaders>
          <Private-Package>!*</Private-Package><Include-Resource>${project.build.outputDirectory}</Include-Resource>
        </instructions></configuration>
      </plugin>
    </plugins>
  </build>
</project>
