<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        YOFC-branded addon .deb builder for the OPC-UA client driver. Source bundle lives
        in the spnettec/kura-opcua sibling repo at
        ../../../kura-opcua/bundles/org.eclipse.kura.driver.opcua.provider/.
    -->
    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>distrib</artifactId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>../../kura/distrib/pom.xml</relativePath>
    </parent>

    <artifactId>kura-opcua-distrib</artifactId>
    <name>kura-opcua-distrib</name>
    <packaging>pom</packaging>

    <properties>
        <addon.installation.dir>/opt/eclipse/kura/plugins</addon.installation.dir>
        <package.name>kura-opcua</package.name>

        <!-- Bundle version (independent of kura framework version). -->
        <opcua.bundle.name>org.eclipse.kura.driver.opcua.provider</opcua.bundle.name>
        <opcua.bundle.version>2.0.0-SNAPSHOT</opcua.bundle.version>

        <!-- Pure Java OPC-UA driver — arch-neutral. -->
        <deb.architecture>all</deb.architecture>

        <!-- Bypass parent's dist lifecycle. -->
        <dist.assembly.skip>true</dist.assembly.skip>
        <dist.linux.bundles.skip>true</dist.linux.bundles.skip>
        <dist.linux.family.skip>true</dist.linux.family.skip>
        <dist.network.resources.skip>true</dist.network.resources.skip>
        <dist.dp.skip>true</dist.dp.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-opcua-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/input_files</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../../kura-opcua/bundles/${opcua.bundle.name}/target</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>${opcua.bundle.name}-${opcua.bundle.version}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb-version}</version>
                <executions>
                    <execution>
                        <id>generate-opcua-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <verbose>true</verbose>
                            <deb>${basedir}/target/${package.name}_${package.version}-${package.revision}_${deb.architecture}.deb</deb>
                            <snapshotExpand>true</snapshotExpand>
                            <snapshotTemplate>${package.snapshot}</snapshotTemplate>
                            <controlDir>${project.basedir}/deb/control</controlDir>
                            <skipPOMs>false</skipPOMs>
                            <dataSet>
                                <data>
                                    <src>${project.build.directory}/input_files/${opcua.bundle.name}-${opcua.bundle.version}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/4s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
