<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>target-platform</artifactId>
        <version>6.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>p2-repo-common</artifactId>
    <packaging>pom</packaging>
    <build>
        <plugins> 
            <plugin>
				<groupId>org.reficio</groupId>
				<artifactId>p2-maven-plugin</artifactId>
				<version>${p2-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>generate-p2-site</id>
						<phase>initialize</phase>
						<goals>
							<goal>site</goal>
						</goals>
						<configuration>
							<artifacts>
							<!-- vertx — only shared bundles (kura-camel + others Import-Package these).
							     yofc-only Vert.x bundles + fastjson2 + javacan shipped by kura-yofc-runtime sibling. -->
								<artifact>
									<id>io.vertx:vertx-core:${vertx.version}</id>
									<source>true</source>
									<transitive>true</transitive>
								</artifact>
								<artifact>
									<id>io.vertx:vertx-web-common:${vertx.version}</id>
									<source>true</source>
									<transitive>false</transitive>
								</artifact>
								<artifact>
									<id>io.vertx:vertx-web-client:${vertx.version}</id>
									<source>true</source>
									<transitive>false</transitive>
								</artifact>
								<!-- digitalpetri kept for milo-transport compile-time Import-Package. Runtime via kura-opcua.deb + kura-yofc-runtime.deb. -->
								<artifact>
									<id>com.digitalpetri.fsm:strict-machine:jar:${strict-machine.version}</id>
									<source>true</source>
									<transitive>false</transitive>
								</artifact>
								<artifact>
									<id>com.digitalpetri.netty:netty-channel-fsm:jar:${netty-channel-fsm.version}</id>
									<source>true</source>
									<transitive>false</transitive>
								</artifact>
                                <!-- Native jar only exports org.eclipse.paho.mqttv5.client; this override
                                     widens exports to include client.persist, common and common.packet
                                     (which are physically present in the jar) for downstream apps that need them. -->
								<artifact>
									<id>org.eclipse.paho:org.eclipse.paho.mqttv5.client:${org.eclipse.paho.client.mqttv3.version}</id>
									<source>true</source>
									<transitive>false</transitive>
									<override>true</override>
									<instructions>
										<Import-Package>*;resolution:=optional</Import-Package>
										<Export-Package>org.eclipse.paho.mqttv5.client;version="1.2.5",
														org.eclipse.paho.mqttv5.client.persist;version="1.2.5",
														org.eclipse.paho.mqttv5.common;version="1.2.5",
														org.eclipse.paho.mqttv5.common.packet;version="1.2.5"
										</Export-Package>
									</instructions>
								</artifact>
								
								<artifact>
									<id>junit:junit:${org.junit.version}</id>
									<source>true</source>
									<transitive>false</transitive>
									<override>true</override>
									<instructions>
										<Export-Package>junit.extensions;version="4.13.2",junit.framework;vers
					                         ion="4.13.2",junit.runner;version="4.13.2",junit.textui;version="4.13
					                         .2",org.junit;version="4.13.2",org.junit.experimental;version="4.13.2
					                         ",org.junit.experimental.categories;version="4.13.2",org.junit.experi
					                         mental.max;version="4.13.2",org.junit.experimental.results;version="4
					                         .13.2",org.junit.experimental.runners;version="4.13.2",org.junit.expe
					                         rimental.theories;version="4.13.2",org.junit.experimental.theories.in
					                         ternal;version="4.13.2";x-internal:=true,org.junit.experimental.theor
					                         ies.suppliers;version="4.13.2",org.junit.internal;version="4.13.2";x-
					                         internal:=true,org.junit.internal.builders;version="4.13.2";x-interna
					                         l:=true,org.junit.internal.matchers;version="4.13.2";x-internal:=true
					                         ,org.junit.internal.requests;version="4.13.2";x-internal:=true,org.ju
					                         nit.internal.runners;version="4.13.2";x-internal:=true,org.junit.inte
					                         rnal.runners.model;version="4.13.2";x-internal:=true,org.junit.intern
					                         al.runners.rules;version="4.13.2";x-internal:=true,org.junit.internal
					                         .runners.statements;version="4.13.2";x-internal:=true,org.junit.match
					                         ers;version="4.13.2",org.junit.rules;version="4.13.2",org.junit.runne
					                         r;version="4.13.2",org.junit.runner.manipulation;version="4.13.2",org
					                         .junit.runner.notification;version="4.13.2",org.junit.runners;version
					                         ="4.13.2",org.junit.runners.model;version="4.13.2",org.junit.runners.
					                         parameterized;version="4.13.2",org.junit.validator;version="4.13.2"
				                        </Export-Package>
										<Bundle-SymbolicName>org.junit</Bundle-SymbolicName>
									</instructions>
								</artifact>
								<artifactItem>
									<id>io.moquette:moquette-broker:${moquette-broker.version}</id>
									<source>true</source>
									<transitive>false</transitive>
								</artifactItem>
                                
                            </artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-p2-bundles-to-local-m2</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/../install-to-m2.sh"
                                      dir="${project.basedir}"
                                      failonerror="true">
                                    <arg value="${project.build.directory}/repository/plugins" />
                                    <arg value="p2.osgi.bundle" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
